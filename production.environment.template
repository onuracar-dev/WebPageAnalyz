# Docker Compose deployment settings. Copy to .env and keep secrets out of Git.
PUBLIC_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080
POSTGRES_TLS_DIR=/srv/webpage-analyzer/secrets/postgres-tls
API_KEYS=
ADMIN_API_KEYS=
LEGACY_API_ENABLED=false
LEGACY_API_ALLOW_UNAUTHENTICATED_DEVELOPMENT=false
ADMIN_REAUTH_MAX_AGE_MS=600000
# Production must keep this true. Local development may set false only for
# non-WebAuthn fixtures; privileged mutations otherwise require a fresh passkey.
ADMIN_WEBAUTHN_REQUIRED=true
ADMIN_PRIVILEGED_ROLES=super_admin,admin
ADMIN_STEP_UP_MAX_AGE_SECONDS=600
ADMIN_WEBAUTHN_MIN_CREDENTIALS=1
ADMIN_WEBAUTHN_RECOMMENDED_CREDENTIALS=2
ADMIN_RECOVERY_CODE_COUNT=10
ADMIN_RECOVERY_SESSION_TTL_SECONDS=900
ADMIN_WEBAUTHN_ASSERTION_TTL_SECONDS=120
# Local-only: docker-compose.local.yml enables one re-auth per login session.
# Production startup rejects true.
ADMIN_REAUTH_SESSION_LIFETIME=false
MAX_CONCURRENT_ANALYSES=1
MAX_QUEUED_ANALYSES=8
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
SCAN_PROGRESS_RATE_LIMIT_WINDOW_MS=900000
SCAN_PROGRESS_RATE_LIMIT_MAX=600
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=600
ADMIN_REAUTH_RATE_LIMIT_WINDOW_MS=900000
ADMIN_REAUTH_RATE_LIMIT_MAX=5
ADMIN_PASSKEY_RATE_LIMIT_WINDOW_MS=900000
ADMIN_PASSKEY_RATE_LIMIT_MAX=20
ADMIN_RECOVERY_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RECOVERY_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX=5
REDEEM_RATE_LIMIT_WINDOW_MS=900000
REDEEM_RATE_LIMIT_MAX=10
ADMIN_MUTATION_RATE_LIMIT_WINDOW_MS=900000
ADMIN_MUTATION_RATE_LIMIT_MAX=60
# The administrator credential is used only by the one-shot bootstrap/grant
# services. The API, analysis worker, maintenance worker and queue use the
# separate role credentials below.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_RUNTIME_PASSWORD=replace-with-a-long-random-runtime-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-long-random-migrator-password
POSTGRES_WORKER_PASSWORD=replace-with-a-long-random-worker-password
POSTGRES_MAINTENANCE_PASSWORD=replace-with-a-long-random-maintenance-password
POSTGRES_QUEUE_PASSWORD=replace-with-a-long-random-queue-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SOURCE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ZAP_API_KEY=replace-with-a-long-random-zap-api-key
OSV_SCANNER_PATH=/usr/local/bin/osv-scanner
# Token-authenticated Engine Lab control channel between the API and the
# analysis worker. This is not a browser/provider credential.
ENGINE_LAB_SERVICE_TOKEN=replace-with-at-least-32-random-characters
MIGRATION_STATEMENT_TIMEOUT_MS=30000
MIGRATION_LOCK_TIMEOUT_MS=10000
MIGRATION_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=10000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Production Compose requires TLS for every role-scoped PostgreSQL URL. Use
# `require` for a managed TLS endpoint or `verify-full` with a trusted CA.
DATABASE_SSLMODE=require
MIGRATION_DATABASE_SSLMODE=require
MIGRATION_REQUIRE_TLS=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Early-access launch: Free signup plus redeem/admin grants, with no provider
# checkout. Change to true only after the complete Paddle block is configured.
PAYMENTS_ENABLED=false
BILLING_PROVIDER=paddle
ENTERPRISE_SALES_MODE=contact
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_SIGNAL=
PADDLE_PRICE_STUDIO=
PADDLE_PRICE_ENTERPRISE=

# Isolated OpenRouter service. The API receives only AI_SERVICE_TOKEN; the
# OpenRouter key is passed only to the ai-service container.
AI_PROVIDER=openrouter
AI_SERVICE_TOKEN=replace-with-at-least-32-random-characters
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=
OPENROUTER_MODEL_FALLBACKS=
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=WebPageAnalyzer
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=false
OPENROUTER_METADATA_ENABLED=true
OPENROUTER_STRUCTURED_OUTPUT_MODE=native
OPENROUTER_REASONING_EFFORT=
AI_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_INPUT_TOKENS=4096
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_COST_SOFT_LIMIT_USD=5
AI_DAILY_COST_HARD_LIMIT_USD=10

# Isolated Resend service. The API receives only EMAIL_SERVICE_TOKEN.
EMAIL_PROVIDER=resend
EMAIL_DELIVERY_ENABLED=true
EMAIL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=support@usewpa.tech
EMAIL_PROVIDER_HOST_ALLOWLIST=api.resend.com
EMAIL_PROVIDER_TIMEOUT_MS=10000

# Published operator data. Production startup fails rather than rendering
# invented or placeholder legal identity. A real business address is required
# when PAYMENTS_ENABLED=true and optional in redeem-only early access.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_TYPE=
LEGAL_COUNTRY=TR
LEGAL_BUSINESS_ADDRESS=
LEGAL_SUPPORT_EMAIL=support@usewpa.tech
LEGAL_SUPPORT_PHONE=
LEGAL_EFFECTIVE_DATE=
LEGAL_HOSTING_PROVIDER_NAME=
LEGAL_HOSTING_PROVIDER_REGION=
LEGAL_HOSTING_PROVIDER_PRIVACY_URL=
LEGAL_EDGE_PROVIDER_NAME=
LEGAL_EDGE_PROVIDER_REGION=
LEGAL_EDGE_PROVIDER_PRIVACY_URL=

CRAWLER_MAX_SITEMAPS=20
CRAWLER_MAX_SITEMAP_DEPTH=3
CRAWLER_MAX_SITEMAP_URLS=5000
CRAWLER_MAX_SITEMAP_BYTES=2097152
CRAWLER_MAX_SITEMAP_DECOMPRESSED_BYTES=8388608
CRAWLER_MAX_PATH_DEPTH=12
CRAWLER_MAX_QUERY_VARIANTS_PER_PATH=5
# A public target URL may leave the VDS for YellowLab only after the user
# confirms the per-scan disclosure. Keep this true in production.
REQUIRE_EXTERNAL_PROVIDER_CONSENT=true

# Optional legacy provider credentials. They are not production defaults.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SIGNAL=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_ENTERPRISE=
GEMINI_API_KEY=
GEMINI_MODEL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Local development with the bundled plaintext Postgres is an explicit opt-in.
# Copy this file to .env.local and run Compose with the checked-in local
# overlay; never use docker-compose.local.yml for a production deployment:
#   docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.local.yml up --build -d
