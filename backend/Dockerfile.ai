FROM node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03

LABEL org.opencontainers.image.title="WebPageAnalyz AI service" \
      org.opencontainers.image.description="Isolated OpenRouter remediation and executive-summary boundary" \
      org.opencontainers.image.source="https://github.com/onuracar-dev/WebPageAnalyz"

ENV NODE_ENV=production \
    EXECUTION_ROLE=ai \
    AI_SERVICE_HOST=0.0.0.0 \
    AI_SERVICE_PORT=5010

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates dumb-init \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chown=node:node ai ./ai
COPY --chown=node:node lib/errors.js lib/logger.js ./lib/
COPY --chown=node:node scripts/ai-service.js ./scripts/ai-service.js

USER node
EXPOSE 5010
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.AI_SERVICE_PORT||5010)+'/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "scripts/ai-service.js"]
