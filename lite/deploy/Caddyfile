# WPA Lite Caddy Configuration
# TLS termination using Cloudflare Origin Certificate (Cloudflare SSL mode: Full (strict))
# Trusted Cloudflare proxy IPs are imported from snippet generated by cloudflare-ips.sh

{
    import /etc/caddy/cloudflare-ips.caddy
}

wpa.onuracar.dev {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    reverse_proxy 127.0.0.1:8081 {
        header_up X-Forwarded-For {client_ip}
    }
}
