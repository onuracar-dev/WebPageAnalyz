# Node Environment
NODE_ENV=production

# Consent Salt (ZORUNLU - Production ortaminda eksikse sunucu acilmaz)
# Uzun rastgele bir deger uretmek icin: openssl rand -hex 32
CONSENT_SALT=

# CORS Allowed Origin (Istemci adresi)
ALLOWED_ORIGIN=https://webpageanalyzer.onuracar.dev

# Trust Proxy (Nginx veya ters proxy arkasinda IP tespiti ve rate limiting icin)
TRUST_PROXY=1

# Resend HTTP API Key (Ana projeden ayri, sadece gonderim yetkili bir anahtar onerilir)
RESEND_API_KEY=

# Iletisim formunun gonderilecegi hedef e-posta adresi (Gercek adres repoya girilmez)
CONTACT_TO=

# Resend uzerinde dogrulanmis gonderici adresi (varsayilan yok, zorunlu)
# Ornek: WPA Lite <noreply@usewpa.tech>
CONTACT_FROM=

# Web container'inin ana makinede (host) dinleyecegi yerel port
# VDS'teki reverse proxy (Nginx / Caddy) 127.0.0.1:8081 adresine yonlendirir
WEB_PORT=8081
