# Node Environment
NODE_ENV=production

# Consent Salt (ZORUNLU - Production ortaminda eksikse sunucu acilmaz)
# Uzun rastgele bir deger uretmek icin: openssl rand -hex 32
CONSENT_SALT=

# CORS Allowed Origin (Istemci adresi)
ALLOWED_ORIGIN=https://wpa.onuracar.dev

# Trust Proxy (Nginx veya ters proxy arkasinda IP tespiti ve rate limiting icin)
TRUST_PROXY=1

# Web container'inin ana makinede (host) dinleyecegi yerel port
# VDS'teki reverse proxy (Caddy / Nginx) 127.0.0.1:8081 adresine yonlendirir
WEB_PORT=8081

